<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <!-- El color base del LED (Se cambiará por código: Verde, Rojo, Gris) -->
    <solid android:color="#00D4FF" />

    <!-- El resplandor exterior (Glow) -->
    <stroke
        android:width="3dp"
        android:color="#4D00D4FF" /> <!-- 30% de opacidad del mismo color -->

    <size
        android:width="12dp"
        android:height="12dp" />
</shape>