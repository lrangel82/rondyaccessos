<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="8dp">

    <!-- Encabezado de Estatus -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lblTopSalidaPeatonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:text="MÓDULO SALIDA PEATONAL: Registre el egreso de la visita"
            android:textColor="#00E676"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/columnaCamaraSalidaPeatonal"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <androidx.camera.view.PreviewView
                android:id="@+id/previewViewRostroSalida"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.6"
                android:background="#000000" />

            <Button
                android:id="@+id/btnCapturarFotoSalida"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="0.4"
                android:backgroundTint="#0288D1"
                android:text="Capturar Foto Salida 📸" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Entrada de búsqueda por coincidencia -->
                <EditText
                    android:id="@+id/txtBuscarVisitante"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Buscar por Nombre o Domicilio (Calle:Num)..."
                    android:inputType="textCapWords"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666666"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnBuscarPeaton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Buscar Registro Activo 🔍" />

                <!-- Tarjeta Informativa del Peatón identificado -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardPeatonEncontrado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#1E1E1E"
                    app:cardCornerRadius="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/lblDetallePeaton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Nombre: Carlos Gómez\nVisitó: Arrayanes #14\nHora Entrada: 14:22:10"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp" />

                        <Button
                            android:id="@+id/btnConfirmarSalidaPeatonal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:backgroundTint="#00E676"
                            android:text="Registrar Egreso Peatonal"
                            android:textColor="#000000" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- COLUMNA IZQUIERDA: Cámara Frontal (CameraX Preview) -->

    <!-- COLUMNA DERECHA: Búsqueda y Confirmación -->

</androidx.constraintlayout.widget.ConstraintLayout>