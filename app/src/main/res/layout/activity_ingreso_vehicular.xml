<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".vehicular.IngresoVehicularActivity"
    android:background="#121212"
    android:padding="8dp">

    <RelativeLayout
        android:id="@+id/headerTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/lblTopMensaje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Asistente de Acceso Activo..."
            android:textColor="#00E676"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/lblTimerInactividad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="Tiempo: 30s"
            android:textColor="#FFB300"
            android:textSize="16sp" />
    </RelativeLayout>

    <!-- SECCIÓN SUPERIOR: Cámaras una al lado de la otra -->
    <LinearLayout
        android:id="@+id/columnaCamaras"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/headerTop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 1. Contenedor de Cámara de Placas (RTSP) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_weight="1"
            android:layout_marginBottom="4dp">

            <!-- Native Video Layout Surface for LibVLC Streaming -->
            <org.videolan.libvlc.util.VLCVideoLayout
                android:id="@+id/vlcPlacaSurface"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000" />

            <!-- Fallback overlay configuration view if connection drops -->
            <LinearLayout
                android:id="@+id/layoutFixCamaraPlaca"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#E6212121"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:padding="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚠️ Error de Señal RTSP" android:textColor="#FF5252" android:textStyle="bold" android:textSize="12sp"/>
                <EditText android:id="@+id/txtUrlRtspFix" android:layout_width="match_parent" android:layout_height="35dp" android:background="#333333" android:textColor="#FFFFFF" android:hint="rtsp://192.168.1.200:554/stream1" android:textSize="11sp" android:paddingStart="6dp" android:layout_marginTop="4dp"/>
                <Button android:id="@+id/btnReconectarRtsp" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Reconectar" android:textSize="10sp" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </RelativeLayout>

        <!-- 2. Contenedor de Cámara de Conductor / QR (Nativa o IP) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp">

            <!-- Native CameraX Preview for Local Device Frame Decoding -->
            <androidx.camera.view.PreviewView
                android:id="@+id/cameraXQrPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000" />

            <!-- Alternative LibVLC layout if the user configures an IP camera instead of local hardware -->
            <org.videolan.libvlc.util.VLCVideoLayout
                android:id="@+id/vlcQrSurfaceFallback"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutFixCamaraQr"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#E6212121"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:padding="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚙️ Configurar Origen QR" android:textColor="#00E676" android:textStyle="bold" android:textSize="12sp"/>
                <Button android:id="@+id/btnCambiarA_IP" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Usar Cámara IP (RTSP)" android:textSize="10sp" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

    <!-- COLUMNA DERECHA: ASISTENTE PASO A PASO SECCIONAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:padding="12dp"
        android:background="#1E1E1E"
        app:layout_constraintTop_toBottomOf="@id/columnaCamaras"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/columnaCamaras"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Instrucción actual en Letras Grandes -->
        <TextView
            android:id="@+id/lblInstruccionSeccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Seleccione el Motivo de Ingreso:"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <!-- Subtítulos de lo que dice/escucha Gemini -->
        <TextView
            android:id="@+id/lblSubtitulosAsistente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🤖 Escuchando..."
            android:textColor="#FFEB3B"
            android:textSize="14sp"
            android:textStyle="italic"
            android:layout_marginBottom="12dp"/>

        <!-- CONTENEDOR DINÁMICO: Grid de Botones Inyectados por Código -->
        <ScrollView
            android:id="@+id/ScrollViewGridBotones"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            tools:visibility="gone">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/containerGridBotones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:itemSpacing="12dp"
                app:lineSpacing="12dp"
                app:singleSelection="true" />
        </ScrollView>

        <!-- Campo de entrada alternativo para teclado manual (Nombre / Placas) -->
        <EditText
            android:id="@+id/txtInputManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:textAlignment="center"
            android:textColor="#050505"
            android:textSize="34sp"
            android:visibility="visible"
            android:inputType="textCapCharacters"
            android:layout_marginBottom="12dp"/>

        <!-- Barra inferior de acciones globales -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">
            <Button
                android:id="@+id/btnReiniciarRegistro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reiniciar / Error 🔄"
                android:backgroundTint="#424242"
                android:layout_marginEnd="6dp"/>
            <Button
                android:id="@+id/btnSiguientePasoManual"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Siguiente ➡️"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>