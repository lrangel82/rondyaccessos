<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="?attr/actionBarSize"
    tools:context=".vehicular.IngresoVehicularActivity"
    android:background="#0A0E14"
    android:padding="12dp">

    <!-- HEADER: Minimalista y Elegante -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/lblTopMensaje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SISTEMA DE ACCESO"
            android:textColor="#00D4FF"
            android:textSize="14sp"
            android:letterSpacing="0.1"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/lblTimerInactividad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_timer_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="30s"
                android:textColor="#FFAB40"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- BOTÓN CONFIGURACIÓN GENERAL -->
            <ImageButton
                android:id="@+id/btnMenuConfiguracion"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="#8B949E" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panelEstadoMicofono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblTopMensaje">

            <View
                android:id="@+id/indicadorColorMicro"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/shape_circle_glow" />

            <TextView
                android:id="@+id/lblEstadoHardwareVoz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="ASISTENTE ESCUCHANDO"
                android:textColor="#8B949E"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- SECCIÓN CÁMARAS: Estilo Dashboard -->
    <LinearLayout
        android:id="@+id/columnaCamaras"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/headerTop">

        <!-- Card Cámara 1 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:cardBackgroundColor="#000000"
            app:cardCornerRadius="16dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp">

            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <org.videolan.libvlc.util.VLCVideoLayout
                    android:id="@+id/vlcPlacaSurface"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- BOTÓN CONFIGURAR CÁMARA PLACAS -->
                <ImageButton
                    android:id="@+id/btnConfigurarCamaraPlacas"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:background="#80000000"
                    android:src="@android:drawable/ic_menu_view"
                    app:tint="#FFFFFF" />

                <!-- Overlay de Error (Aquí está el txtUrlRtspFix) -->
                <LinearLayout
                    android:id="@+id/layoutFixCamaraPlaca"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#E6161B22"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="FALLA DE SEÑAL" android:textColor="#FF5252" android:textStyle="bold"/>
                    <EditText
                        android:id="@+id/txtUrlRtspFix"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="rtsp://url..."
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                    <Button android:id="@+id/btnReconectarRtsp" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="REINTENTAR"/>
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="8dp"
                android:background="#80000000"
                android:paddingHorizontal="6dp"
                android:text="LPR CAM"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Card Cámara 2 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            app:cardBackgroundColor="#000000"
            app:cardCornerRadius="16dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp">

            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <androidx.camera.view.PreviewView
                    android:id="@+id/cameraXQrPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <View
                    android:id="@+id/qrGuideFrame"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:background="@drawable/qr_frame_border_modern" />

                <!-- BOTÓN SWITCH CÁMARA QR -->
                <ImageButton
                    android:id="@+id/btnSwitchCamera"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:background="#80000000"
                    android:src="@android:drawable/ic_menu_rotate"
                    app:tint="#FFFFFF" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- INTERACCIÓN: El "Cerebro" de la App -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#161B22"
        app:cardCornerRadius="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/columnaCamaras"
        tools:layout_editor_absoluteX="12dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            tools:visibility="visible">

            <TextView
                android:id="@+id/lblHistorialDatos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PENDIENTE"
                android:textColor="#8B949E"
                android:textSize="11sp"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/lblInstruccionSeccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Seleccione motivo"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />

            <!-- Subtítulos estilo Chat IA -->
            <TextView
                android:id="@+id/lblSubtitulosAsistente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_ai_bubble"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="🤖 ¿En qué puedo ayudarle?"
                android:textColor="#00D4FF"
                android:textSize="14sp" />

            <ScrollView
                android:id="@+id/ScrollViewGridBotones"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:fadeScrollbars="false"
                android:scrollbarThumbVertical="@color/material_dynamic_neutral40">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/containerGridBotones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp"
                    app:singleSelection="true" />
            </ScrollView>

            <!-- Input Manual Moderno -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutInputManual"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:boxStrokeColor="#00D4FF"
                app:hintTextColor="#00D4FF">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtInputManual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReiniciarRegistro"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:text="CANCELAR"
                    android:textColor="#FF5252" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSiguientePasoManual"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#00D4FF"
                    android:text="SIGUIENTE"
                    app:cornerRadius="12dp" />
            </LinearLayout>
            <TextView
                android:id="@+id/lbStatusAsistente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Estado: Standby"
                android:textAlignment="viewEnd"
                android:textColor="#03A9F4"
                android:textSize="10sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:id="@+id/layoutVisualEstatusDerecho"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#ffffff"
        android:elevation="5dp"
        android:padding="24dp"
        android:visibility="gone"
        tools:layout_editor_absoluteX="12dp"
        tools:layout_editor_absoluteY="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"> <!-- Managed dynamically in code -->

            <TextView
                android:id="@+id/tvEstatusGrande"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="AUTORIZADO"
                android:textSize="54sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEstatusDetallePeque"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Razón: Ingreso Estándar"
                android:textSize="22sp" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/layoutSplash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#5CD563"
        android:clickable="true"
        android:elevation="100dp"
        android:focusable="true"
        android:visibility="gone"
        tools:layout_editor_absoluteX="8dp"
        tools:layout_editor_absoluteY="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="300dp"
                android:layout_height="300dp"
                android:src="@drawable/logo_sintext2" /> <!-- Tu logo o Gif -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="¡HOLA!"
                android:textColor="#FFFFFF"
                android:textSize="80sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>