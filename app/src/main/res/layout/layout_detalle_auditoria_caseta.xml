<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6000000"
    android:padding="24dp">

    <!-- Tarjeta Central de Información de Auditoría -->
    <androidx.cardview.widget.CardView
        android:layout_width="650dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1E1E1E"
        app:cardCornerRadius="12dp"
        app:cardElevation="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Cabecera de Alerta -->
            <RowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/lblAuditoriaTitulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PANEL DE AUDITORÍA REMOTA"
                    android:textColor="#FFEB3B"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                <Button
                    android:id="@+id/btnCerrarAuditoria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❌"
                    style="@style/Widget.MaterialComponents.Button.TextButton"/>
            </RowLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"/>

            <!-- Sección de Video Remoto y Datos en Espejo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- Simulación Foto Placa / Rostro enviada por el satélite -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#000000"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CAPTURA DEL SATÉLITE"
                        android:textColor="#444444"
                        android:layout_gravity="center"
                        android:textSize="11sp"/>
                </FrameLayout>

                <!-- Campos de texto con el estatus detallado del Condominio -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/lblAuditoriaDireccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Domicilio: Circuito Olmos #24"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/lblAuditoriaEstatusCasa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Estatus: DOMICILIO MOROSO 📑"
                        android:textColor="#FF5252"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/lblAuditoriaExtensiones"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Extensiones: Conmutador Int. 202"
                        android:textColor="#B0BEC5"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/lblAuditoriaDetalleVisita"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pasajero: Proveedor DHL\nMotivo: Entrega paquetería"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠️ Nota: Si el domicilio es moroso, el sistema bloquea el ingreso automático en el satélite por seguridad del condominio."
                android:textColor="#FF8A80"
                android:textSize="11sp"
                android:layout_marginTop="12dp"
                android:textStyle="italic"/>

            <!-- Botonera Táctica de Control Remoto -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnLlamarResponsable"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Contactar Residentes 📞"
                    android:backgroundTint="#0288D1"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/btnForzarAperturaRemota"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Autorizar y Abrir Barrera 🔓"
                    android:backgroundTint="#388E3C"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>