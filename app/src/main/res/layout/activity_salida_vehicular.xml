<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="12dp"
    tools:context=".salida.SalidaVehicularActivity">

    <!-- Mensaje de Estado -->
    <TextView
        android:id="@+id/lblTopSalida"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="MÓDULO SALIDA VEHICULAR: Escaneando Placas..."
        android:textColor="#00E676"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Stream de Cámara IP / Lector de Placas de Salida -->
    <FrameLayout
        android:id="@+id/containerCamaraSalida"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:layout_marginTop="8dp"
        android:background="#000000"
        app:layout_constraintTop_toBottomOf="@id/lblTopSalida"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CÁMARA IP: RECONOCIMIENTO PLACA DE SALIDA"
            android:textColor="#555555"
            android:layout_gravity="center"
            android:textSize="12sp"/>
    </FrameLayout>

    <!-- Buscador Manual Completo por si falla el OCR de la Cámara -->
    <EditText
        android:id="@+id/txtBuscarPlacaSalida"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Digitar Placa Manual / Buscar..."
        android:textColorHint="#666666"
        android:textColor="#FFFFFF"
        android:inputType="textCapCharacters"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/containerCamaraSalida"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnBuscarManual"/>

    <Button
        android:id="@+id/btnBuscarManual"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Buscar"
        app:layout_constraintTop_toTopOf="@id/txtBuscarPlacaSalida"
        app:layout_constraintBottom_toBottomOf="@id/txtBuscarPlacaSalida"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Contenedor para mostrar datos del vehículo encontrado -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardVehiculoEncontrado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#1E1E1E"
        app:cardCornerRadius="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/txtBuscarPlacaSalida"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/lblDetalleVehiculo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Placa: ABC-123\nProcedencia: Calle Bugambilias #45\nConductor: Juan Pérez"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>

            <Button
                android:id="@+id/btnDarSalidaVehiculo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Confirmar Salida y Abrir Barrera"
                android:backgroundTint="#00E676"
                android:textColor="#000000"
                android:layout_marginTop="12dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Botón de pánico por si el auto no tiene registro de entrada (Mapeado de Python Parte 5) -->
    <Button
        android:id="@+id/btnForzarRegistroSalida"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="Vehículo sin Entrada: Registrar y Dar Salida ⚠️"
        android:backgroundTint="#D32F2F"
        android:visibility="visible"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>