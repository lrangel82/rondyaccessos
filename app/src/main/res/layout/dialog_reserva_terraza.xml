<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E1E1E"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nuevo Apartado de Terraza"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/inputDomicilioReserva"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Calle y Número (ej: Bugambilias:40)"
        android:textColorHint="#555555"
        android:textColor="#FFFFFF"/>

    <EditText
        android:id="@+id/inputFechaEvento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Fecha (YYYY-MM-DD)"
        android:textColorHint="#555555"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btnConfirmarYGenerarQr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Generar Pase de Acceso QR"
        android:backgroundTint="#388E3C"
        android:layout_marginTop="16dp"/>

    <ImageView
        android:id="@+id/imgGeneratedQr"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        android:contentDescription="Pase QR"/>
</LinearLayout>