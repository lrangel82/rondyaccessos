<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="8dp"
    tools:context=".peatonal.IngresoPeatonalActivity">


    <!-- Mensaje de Estado Superior -->
    <TextView
        android:id="@+id/lblTopMensajePeatonal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Esperando visitante peatonal..."
        android:textColor="#00E676"
        android:textSize="20sp"
        android:textStyle="bold"
        android:padding="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- COLUMNA IZQUIERDA: Cámara Frontal (CameraX Preview) -->
    <LinearLayout
        android:id="@+id/columnaCamaraPeatonal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/lblTopMensajePeatonal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineCentroPeatonal">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewViewRostro"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.5"
            android:background="#000000" />

        <!-- Subtítulos de asistencia por voz de Gemini -->
        <TextView
            android:id="@+id/lblSubtitulosPeatonal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.5"
            android:text=""
            android:textColor="#FFEB3B"
            android:textStyle="italic"
            android:padding="4dp"
            android:textSize="14sp"/>
    </LinearLayout>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineCentroPeatonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.45" />

    <!-- COLUMNA DERECHA: Formulario Peatonal -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toBottomOf="@id/lblTopMensajePeatonal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/guidelineCentroPeatonal"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/txtCallePeatonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#FFFFFF"
                    android:hint="Calle"
                    android:textColorHint="#666666"/>
                <EditText
                    android:id="@+id/txtNumeroPeatonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#FFFFFF"
                    android:hint="Número"
                    android:textColorHint="#666666"
                    android:inputType="number"/>
            </LinearLayout>

            <TextView
                android:id="@+id/lblMorosidadPeatonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#00E676"
                android:layout_marginTop="4dp"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/txtNombrePeatonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FFFFFF"
                android:hint="Nombre del Visitante"
                android:textColorHint="#666666"
                android:inputType="textCapWords"/>

            <EditText
                android:id="@+id/txtMotivoPeatonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FFFFFF"
                android:hint="Razón de la Visita"
                android:textColorHint="#666666"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:weightSum="2">
                <Button
                    android:id="@+id/btnTomarFoto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Capturar Rostro"
                    android:backgroundTint="#0288D1"
                    android:layout_marginEnd="4dp"/>
                <Button
                    android:id="@+id/btnGuardarPeatonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Permitir Ingreso"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>