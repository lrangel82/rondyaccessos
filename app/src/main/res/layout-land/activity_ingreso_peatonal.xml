<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E14"
    android:padding="12dp"
    tools:context=".peatonal.IngresoPeatonalActivity">


    <!-- HEADER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="12dp">

        <TextView
            android:id="@+id/lblTopMensaje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="CONTROL PEATONAL"
            android:textColor="#00D4FF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/lblTimerInactividad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_timer_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="60s"
            android:textColor="#FFAB40"
            app:layout_constraintEnd_toStartOf="@+id/btnMenuConfiguracion"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnMenuConfiguracion"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="#8B949E"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblTopMensaje">

            <View
                android:id="@+id/indicadorColorMicro"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/shape_circle_glow" />

            <TextView
                android:id="@+id/lblEstadoHardwareVoz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="ASISTENTE ACTIVO"
                android:textColor="#8B949E"
                android:textSize="11sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ÁREA DE CÁMARA (ROSTRO) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCamara"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#000000"
        app:cardCornerRadius="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guidelineCentroPeatonal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerTop"
        app:strokeColor="#30363D"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:foregroundGravity="center">

            <androidx.camera.view.PreviewView
                android:id="@+id/cameraXQrPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <View
                android:id="@+id/qrGuideFrame"
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:layout_gravity="center"
                android:background="@drawable/qr_frame_border_modern" />

            <ImageView
                android:id="@+id/ivFacePreview"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="bottom|start"
                android:layout_margin="12dp"
                android:contentDescription="Vista previa del rostro"
                android:scaleType="centerCrop"
                android:elevation="12dp"
                android:background="@drawable/shape_circle_glow"/>

            <!-- BOTÓN SWITCH CÁMARA QR -->
            <ImageButton
                android:id="@+id/btnSwitchCamera"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="#80000000"
                android:src="@android:drawable/ic_menu_rotate"
                app:tint="#FFFFFF" />

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>


    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineCentroPeatonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.45" />

    <!-- PANEL DE INTERACCIÓN -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="#161B22"
        app:cardCornerRadius="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cardCamara"
        app:layout_constraintTop_toBottomOf="@+id/headerTop">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/lblHistorialDatos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PENDIENTE"
                android:textColor="#8B949E"
                android:textSize="11sp"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/lblInstruccionSeccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Identifique al visitante"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblSubtitulosAsistente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_ai_bubble"
                android:padding="8dp"
                android:text="🤖 Esperando identificación..."
                android:textColor="#00D4FF" />

            <ScrollView
                android:id="@+id/ScrollViewGridBotones"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:fadeScrollbars="false"
                android:scrollbarThumbVertical="@color/material_dynamic_neutral40">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/containerGridBotones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp"
                    app:singleSelection="true"/>
            </ScrollView>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxStrokeColor="#00D4FF">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtInputManual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReiniciarRegistro"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:text="CANCELAR"
                    android:textColor="#FF5252" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSiguientePasoManual"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#00D4FF"
                    android:text="SIGUIENTE"
                    app:cornerRadius="12dp" />
            </LinearLayout>
            <TextView
                android:id="@+id/lbStatusAsistente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Estado: Standby"
                android:textAlignment="viewEnd"
                android:textColor="#03A9F4"
                android:textSize="10sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:id="@+id/layoutVisualEstatusDerecho"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#ffffff"
        android:elevation="50dp"
        android:padding="24dp"
        android:visibility="gone"
        tools:layout_editor_absoluteX="12dp"
        tools:layout_editor_absoluteY="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"> <!-- Managed dynamically in code -->

            <TextView
                android:id="@+id/tvEstatusGrande"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="AUTORIZADO"
                android:textSize="56sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEstatusDetallePeque"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Razón: Ingreso Estándar"
                android:textSize="22sp" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/layoutSplash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#5CD563"
        android:clickable="true"
        android:elevation="100dp"
        android:focusable="true"
        android:visibility="gone"
        tools:layout_editor_absoluteX="8dp"
        tools:layout_editor_absoluteY="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="300dp"
                android:layout_height="300dp"
                android:src="@drawable/logo" /> <!-- Tu logo o Gif -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="¡HOLA!"
                android:textColor="#FFFFFF"
                android:textSize="80sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>