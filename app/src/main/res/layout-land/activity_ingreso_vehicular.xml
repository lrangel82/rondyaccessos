<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".vehicular.IngresoVehicularActivity"
    android:background="#121212"
    android:padding="8dp">

    <!-- Banner superior de Estado y Cronómetro de Inactividad -->
    <RelativeLayout
        android:id="@+id/headerTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/lblTopMensaje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Asistente de Acceso Activo..."
            android:textColor="#00E676"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/lblTimerInactividad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="Tiempo: 30s"
            android:textColor="#FFB300"
            android:textSize="16sp" />
    </RelativeLayout>

    <!-- COLUMNA IZQUIERDA: Flujos de Cámaras IP (RTSP) -->
    <LinearLayout
        android:id="@+id/columnaCamaras"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:weightSum="2"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/headerTop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineCentro">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000"
            android:layout_marginBottom="4dp">
            <!-- Superficie LibVLC Cámara Placas -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CÁMARA IP: LECTOR PLACAS" android:textColor="#888888" android:layout_gravity="center"/>
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000"
            android:layout_marginTop="4dp">
            <!-- Superficie LibVLC Cámara Rostro -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CÁMARA IP: CONDUCTOR / QR" android:textColor="#888888" android:layout_gravity="center"/>
        </FrameLayout>
    </LinearLayout>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineCentro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.40" />

    <!-- COLUMNA DERECHA: ASISTENTE PASO A PASO SECCIONAL -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:padding="12dp"
        android:background="#1E1E1E"
        app:layout_constraintTop_toBottomOf="@id/headerTop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/guidelineCentro"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Instrucción actual en Letras Grandes -->
        <TextView
            android:id="@+id/lblInstruccionSeccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Seleccione el Motivo de Ingreso:"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <!-- Subtítulos de lo que dice/escucha Gemini -->
        <TextView
            android:id="@+id/lblSubtitulosAsistente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🤖 Escuchando..."
            android:textColor="#FFEB3B"
            android:textSize="14sp"
            android:textStyle="italic"
            android:layout_marginBottom="12dp"/>

        <!-- CONTENEDOR DINÁMICO: Grid de Botones Inyectados por Código -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/containerGridBotones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:itemSpacing="12dp"
                app:lineSpacing="12dp"
                app:singleSelection="true" />
        </ScrollView>

        <!-- Campo de entrada alternativo para teclado manual (Nombre / Placas) -->
        <EditText
            android:id="@+id/txtInputManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:visibility="gone"
            android:inputType="textCapCharacters"
            android:layout_marginBottom="12dp"/>

        <!-- Barra inferior de acciones globales -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">
            <Button
                android:id="@+id/btnReiniciarRegistro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reiniciar / Error 🔄"
                android:backgroundTint="#424242"
                android:layout_marginEnd="6dp"/>
            <Button
                android:id="@+id/btnSiguientePasoManual"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Siguiente ➡️"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>