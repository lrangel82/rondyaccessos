<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="?attr/actionBarSize"
    android:background="#121212"
    android:padding="8dp"
    tools:context=".vehicular.IngresoVehicularActivity"
    tools:visibility="visible">

    <!-- Banner superior de Estado y Cronómetro de Inactividad -->
    <RelativeLayout
        android:id="@+id/headerTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/lblTopMensaje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Asistente de Acceso Activo..."
            android:textColor="#00E676"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/panelEstadoMicofono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_toStartOf="@+id/btnMenuConfiguracion"
            android:background="#212121"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <!-- Círculo indicador de color -->
            <View
                android:id="@+id/indicadorColorMicro"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="6dp"
                android:background="@android:color/darker_gray" />

            <TextView
                android:id="@+id/lblEstadoHardwareVoz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INACTIVO"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnMenuConfiguracion"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:layout_marginEnd="16dp"
            android:layout_toStartOf="@+id/lblTimerInactividad"
            android:text="⚙️"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/lblTimerInactividad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="Tiempo: 30s"
            android:textColor="#FFB300"
            android:textSize="16sp" />
    </RelativeLayout>

    <!-- COLUMNA IZQUIERDA: Flujos de Cámaras IP (RTSP) -->
    <LinearLayout
        android:id="@+id/columnaCamaras"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:weightSum="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineCentro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerTop">

        <!-- 1. Contenedor de Cámara de Placas (RTSP) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            tools:visibility="visible">

            <!-- Native Video Layout Surface for LibVLC Streaming -->
            <org.videolan.libvlc.util.VLCVideoLayout
                android:id="@+id/vlcPlacaSurface"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000"
                android:visibility="visible" />

            <!-- Fallback overlay configuration view if connection drops -->
            <LinearLayout
                android:id="@+id/layoutFixCamaraPlaca"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#E6212121"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Error de Señal RTSP"
                    android:textColor="#FF5252"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/txtUrlRtspFix"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_marginTop="4dp"
                    android:background="#333333"
                    android:hint="rtsp://192.168.1.200:554/stream1"
                    android:paddingStart="6dp"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnReconectarRtsp"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginTop="4dp"
                    android:text="Reconectar"
                    android:textSize="10sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- 2. Contenedor de Cámara de Conductor / QR (Nativa o IP) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:layout_weight="1">

            <!-- Native CameraX Preview for Local Device Frame Decoding -->
            <androidx.camera.view.PreviewView
                android:id="@+id/cameraXQrPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FF0000"
                app:implementationMode="compatible" />

            <!-- Alternative LibVLC layout if the user configures an IP camera instead of local hardware -->
            <org.videolan.libvlc.util.VLCVideoLayout
                android:id="@+id/vlcQrSurfaceFallback"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutFixCamaraQr"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#E6212121"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️ Configurar Origen QR"
                    android:textColor="#00E676"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCambiarA_IP"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginTop="4dp"
                    android:text="Usar Cámara IP (RTSP)"
                    android:textSize="10sp" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineCentro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.40" />

    <!-- COLUMNA DERECHA: ASISTENTE PASO A PASO SECCIONAL -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:background="#1E1E1E"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/guidelineCentro"
        app:layout_constraintTop_toBottomOf="@id/headerTop">

        <TextView
            android:id="@+id/lblHistorialDatos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Datos:"
            android:textAllCaps="false"
            android:textColor="@color/material_dynamic_neutral99"
            android:textStyle="italic" />

        <!-- Instrucción actual en Letras Grandes -->
        <TextView
            android:id="@+id/lblInstruccionSeccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="1. Seleccione el Motivo de Ingreso:"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Subtítulos de lo que dice/escucha Gemini -->
        <TextView
            android:id="@+id/lblSubtitulosAsistente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="🤖 Escuchando..."
            android:textColor="#FFEB3B"
            android:textSize="14sp"
            android:textStyle="italic" />

        <!-- CONTENEDOR DINÁMICO: Grid de Botones Inyectados por Código -->
        <ScrollView
            android:id="@+id/ScrollViewGridBotones"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            tools:visibility="gone">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/containerGridBotones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:itemSpacing="12dp"
                app:lineSpacing="12dp"
                app:singleSelection="true" />
        </ScrollView>

        <!-- Campo de entrada alternativo para teclado manual (Nombre / Placas) -->
        <EditText
            android:id="@+id/txtInputManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@color/white"
            android:inputType="textCapCharacters"
            android:textAlignment="center"
            android:textColor="#050505"
            android:textSize="34sp"
            android:visibility="visible" />

        <!-- Barra inferior de acciones globales -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnReiniciarRegistro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#424242"
                android:text="Reiniciar / Error 🔄" />

            <Button
                android:id="@+id/btnSiguientePasoManual"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Siguiente ➡️" />

        </LinearLayout>

        <TextView
            android:id="@+id/lbStatusAsistente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estado asistente"
            android:textAlignment="viewEnd"
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            android:textColor="#03A9F4"
            android:textStyle="italic" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/layoutVisualEstatusDerecho"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        android:visibility="gone"
        tools:layout_editor_absoluteX="314dp"
        tools:layout_editor_absoluteY="269dp"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/panelColorContenedor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/popupMenuBackground"
            android:gravity="center"
            android:orientation="vertical"
            > <!-- Managed dynamically in code -->

            <TextView
                android:id="@+id/tvEstatusGrande"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="AUTORIZADO"
                android:textSize="56sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEstatusDetallePeque"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Razón: Ingreso Estándar"
                android:textSize="22sp" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>