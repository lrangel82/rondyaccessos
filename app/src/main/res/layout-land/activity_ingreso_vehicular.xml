<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="?attr/actionBarSize"
    android:background="#0A0E14"
    android:padding="8dp"
    tools:context=".vehicular.IngresoVehicularActivity">

    <!-- HEADER: Minimalista con Timer y Configuración -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/lblTopMensaje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="SISTEMA DE ACCESO INTELIGENTE"
            android:textColor="#00D4FF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/lblTimerInactividad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_timer_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="30s"
                android:textColor="#FFAB40"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnMenuConfiguracion"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginStart="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="#8B949E" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panelEstadoMicofono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblTopMensaje">

            <View
                android:id="@+id/indicadorColorMicro"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/shape_circle_glow" />

            <TextView
                android:id="@+id/lblEstadoHardwareVoz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="INACTIVO"
                android:textColor="#8B949E"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- COLUMNA IZQUIERDA: Cámaras en vertical (40% de la pantalla) -->
    <LinearLayout
        android:id="@+id/columnaCamaras"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:weightSum="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineCentro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerTop">

        <!-- Card Cámara 1: LPR -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#000000"
            app:cardCornerRadius="12dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp">

            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <org.videolan.libvlc.util.VLCVideoLayout
                    android:id="@+id/vlcPlacaSurface"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageButton
                    android:id="@+id/btnConfigurarCamaraPlacas"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:background="#80000000"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="#FFFFFF" />

                <LinearLayout
                    android:id="@+id/layoutFixCamaraPlaca"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#E6161B22"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ERROR RTSP" android:textColor="#FF5252" android:textSize="10sp" android:textStyle="bold" />
                    <EditText android:id="@+id/txtUrlRtspFix" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#333333" android:textColor="#FFFFFF" android:textSize="10sp" />
                    <Button android:id="@+id/btnReconectarRtsp" android:layout_width="wrap_content" android:layout_height="32dp" android:text="REINTENTAR" android:textSize="9sp" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card Cámara 2: QR -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#000000"
            app:cardCornerRadius="12dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp">

            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <androidx.camera.view.PreviewView
                    android:id="@+id/cameraXQrPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <View
                    android:id="@+id/qrGuideFrame"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:background="@drawable/qr_frame_border_modern" />

                <ImageButton
                    android:id="@+id/btnSwitchCamera"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:background="#80000000"
                    android:src="@android:drawable/ic_menu_rotate"
                    app:tint="#FFFFFF" />

                <org.videolan.libvlc.util.VLCVideoLayout
                    android:id="@+id/vlcQrSurfaceFallback"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutFixCamaraQr"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#E6161B22"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <Button android:id="@+id/btnCambiarA_IP" android:layout_width="wrap_content" android:layout_height="32dp" android:text="USAR RTSP" android:textSize="9sp" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineCentro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.40" />

    <!-- COLUMNA DERECHA: Interacción (Cerebro de la UI) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="#161B22"
        app:cardCornerRadius="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/guidelineCentro"
        app:layout_constraintTop_toBottomOf="@id/headerTop">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/lblHistorialDatos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PENDIENTE"
                android:textColor="#8B949E"
                android:textSize="11sp"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/lblInstruccionSeccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Seleccione motivo"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/lblSubtitulosAsistente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_ai_bubble"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="🤖 Escuchando..."
                android:textColor="#00D4FF"
                android:textSize="13sp" />

            <ScrollView
                android:id="@+id/ScrollViewGridBotones"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1">
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/containerGridBotones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingVertical="4dp"
                    app:chipSpacingHorizontal="8dp" />
            </ScrollView>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutInputManual"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                app:boxStrokeColor="#00D4FF"
                app:hintEnabled="false">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtInputManual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReiniciarRegistro"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="REINICIAR"
                    android:textColor="#FF5252" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSiguientePasoManual"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cornerRadius="8dp"
                    android:text="CONTINUAR"
                    android:backgroundTint="#00D4FF" />
            </LinearLayout>

            <TextView
                android:id="@+id/lbStatusAsistente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Estado: Standby"
                android:textAlignment="viewEnd"
                android:textColor="#03A9F4"
                android:textSize="10sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- PANELES DE ESTADO (Splash y Resultados) -->

    <FrameLayout
        android:id="@+id/layoutVisualEstatusDerecho"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="50dp"
        android:visibility="gone"
        tools:layout_editor_absoluteX="8dp"
        tools:layout_editor_absoluteY="8dp">

        <LinearLayout
            android:id="@+id/panelColorContenedor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E60A0E14"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEstatusGrande"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUTORIZADO"
                android:textColor="#00E676"
                android:textSize="64sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEstatusDetallePeque"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bienvenido al Condominio"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/layoutSplash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_splash_gradient"
        android:clickable="true"
        android:elevation="100dp"
        android:focusable="true"
        android:visibility="gone"
        tools:layout_editor_absoluteX="8dp"
        tools:layout_editor_absoluteY="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:src="@drawable/logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¡HOLA!"
                android:textColor="#FFFFFF"
                android:textSize="80sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toque la pantalla o diga HOLA"
                android:textColor="#8B949E"
                android:textSize="18sp" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>